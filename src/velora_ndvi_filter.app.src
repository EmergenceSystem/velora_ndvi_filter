{application, velora_ndvi_filter, [
    {description, "Emergence filter: NDVI / vegetation index, computed by velora"},
    {vsn, "0.1.0"},
    {registered, [velora_ndvi_filter_sup, velora_ndvi_filter_server]},
    {mod, {velora_ndvi_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        inets,
        ssl,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   9212},
        {query_port, 9213},
        {pop_seeds,  []},
        {velora_url, "http://127.0.0.1:8080/agent/query"}
    ]},
    {modules, [
        velora_ndvi_filter_app,
        velora_ndvi_filter_sup,
        velora_ndvi_filter_server,
        velora_ndvi_filter_handler
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/velora_ndvi_filter"}]}
]}.
